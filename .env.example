# =============================================================================
# APPLICATION
# =============================================================================
HOST="0.0.0.0"
PORT=8000
UVICORN_WORKERS=1
LOG_LEVEL="INFO"

# =============================================================================
# AUTHENTICATION (API Gateway 도입 전 개발용)
# =============================================================================
# 필수. 비우면 docker compose 가 기동을 거부함. 아래는 예시 값
API_AUTH_USERNAME="admin"
API_AUTH_PASSWORD="change-me-strong-password"
JWT_SECRET_KEY="change-this-secret-key"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional API key for X-API-Key header (parallel to JWT); unset disables
# API_KEY="change-me-api-key"

# =============================================================================
# OPERATIONS
# =============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOW_ORIGINS="*"

# =============================================================================
# V2 DATA SOURCES
# =============================================================================
# 중앙 메트릭 백엔드(PromQL 호환)
PROMETHEUS_URL=""

# Loki HTTP API (OPT.003 로그 검색)
LOKI_URL=""

# OpenStack
OPENSTACK_AUTH_URL=""
OPENSTACK_NOVA_URL=""
OPENSTACK_PLACEMENT_URL=""
OPENSTACK_MAGNUM_URL=""
OPENSTACK_CYBORG_URL=""
OPENSTACK_USERNAME=""
OPENSTACK_PASSWORD=""
OPENSTACK_PROJECT_NAME=""

# 알람 저장소 PostgreSQL (docker compose 의 db 서비스). 세 값 모두 필수, 기본값 없음
# 비밀번호 생성 예: openssl rand -base64 24
# 외부 PostgreSQL 을 쓰면 아래 대신 DATABASE_URL=postgresql://계정:비밀번호@호스트:5432/디비명
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# 알람 메일 채널 (SMTP). 비우면 email 채널 발송 실패로 기록
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="kcloud-monitor@example.com"
