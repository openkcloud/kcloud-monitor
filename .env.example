# =============================================================================
# APPLICATION
# =============================================================================
HOST="0.0.0.0"
PORT=8000
UVICORN_WORKERS=1
LOG_LEVEL="INFO"

# =============================================================================
# AUTHENTICATION (API Gateway 도입 전 개발용)
# =============================================================================
API_AUTH_USERNAME="admin"
API_AUTH_PASSWORD="changeme"
JWT_SECRET_KEY="change-this-secret-key"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional API key for X-API-Key header (parallel to JWT); unset disables
# API_KEY="change-me-api-key"

# =============================================================================
# OPERATIONS
# =============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOW_ORIGINS="*"

# =============================================================================
# V2 DATA SOURCES
# =============================================================================
# 중앙 메트릭 백엔드(PromQL 호환)
PROMETHEUS_URL=""

# Loki HTTP API (OPT.003 로그 검색)
LOKI_URL=""

# OpenStack
OPENSTACK_AUTH_URL=""
OPENSTACK_NOVA_URL=""
OPENSTACK_PLACEMENT_URL=""
OPENSTACK_MAGNUM_URL=""
OPENSTACK_USERNAME=""
OPENSTACK_PASSWORD=""
OPENSTACK_PROJECT_NAME=""
