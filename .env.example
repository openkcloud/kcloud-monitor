# KCloud Monitor v2 - Environment Template
# Copy to .env and adjust values for your deployment.
# 스캐폴드 단계: AUTHENTICATION/OPERATIONS 그룹만 실제 사용된다.
# "V2 DATA SOURCES" 그룹은 구현 시 활성화 (docs/temp/02-decisions/data_source_v1_to_v2.md §4).

# =============================================================================
# APPLICATION
# =============================================================================
HOST="0.0.0.0"
PORT=8000
UVICORN_WORKERS=1
LOG_LEVEL="INFO"

# =============================================================================
# AUTHENTICATION (API Gateway 도입 전 개발용)
# =============================================================================
API_AUTH_USERNAME="admin"
API_AUTH_PASSWORD="changeme"
JWT_SECRET_KEY="change-this-secret-key"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional API key for X-API-Key header (parallel to JWT); unset disables
# API_KEY="change-me-api-key"

# =============================================================================
# OPERATIONS
# =============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOW_ORIGINS="*"

# =============================================================================
# V2 DATA SOURCES (스캐폴드 단계 미사용 — 구현 시 활성화)
# =============================================================================
# 중앙 메트릭 백엔드(PromQL 호환). 전환기에는 기존 Prometheus URL 지정 가능.
# MIMIR_URL="http://mimir.example.com:9009"
# MIMIR_TENANT_ID="kcloud"

# PostgreSQL — resource-map 원장
# DATABASE_URL="postgresql://user:password@localhost:5432/kcloud"

# Redis — 캐시 + Streams 이벤트 버스
# REDIS_URL="redis://localhost:6379/0"

# OpenStack (Keystone; 하이퍼바이저/Placement 조회는 admin/system-reader 필요)
# OPENSTACK_AUTH_URL="http://openstack.example.com:5000/v3"
# OPENSTACK_USERNAME="monitor"
# OPENSTACK_PASSWORD="secret"
# OPENSTACK_PROJECT_NAME="monitoring"

# 클러스터 레지스트리 (관리/서비스 구분)
# CLUSTER_REGISTRY='[{"name":"mgmt","type":"management"},{"name":"svc-1","type":"service"}]'
